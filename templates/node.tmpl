{{define "content"}}
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Node details</h1>
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div id="node-message-block"></div>
                <div class="d-flex justify-content-between align-items-center">
                    <h3>LCM Agent information</h3>
                    <div id="node-action-block"></div>
                </div>
                <div id="agent-info-block">
                    <div><strong>Name:</strong> <span id="agent-name"></span></div>
                    <div><strong>Certificate expiration:</strong> <span id="agent-thumbprint"></span></div>
                    <div><strong>Last Communication:</strong> <span id="agent-lastcomm"></span></div>
                    <div id="agent-config-block"></div>
                </div>
                <hr>
                <h3>Tags</h3>
                <div id="agent-tags-block"></div>
                <form id="add-tag-form" class="form-inline mb-2">
                    <input type="text" class="form-control mr-2" id="tag-key" placeholder="Clé (ex: environnement)" required style="max-width:180px;">
                    <input type="text" class="form-control mr-2" id="tag-value" placeholder="Valeur (ex: production)" required style="max-width:180px;">
                    <button type="submit" class="btn btn-primary">Ajouter</button>
                </form>
                <hr>
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">DSC Report</h3>
                    <button id="export-reports-csv-btn" class="btn btn-outline-success btn-sm"><i class="fas fa-file-csv"></i> Export CSV</button>
                </div>
                <div id="reports-dropdown-block" style="margin-bottom:1em;"></div>
                <div id="last-report-block"></div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line mr-2"></i>Status History</h3>
            </div>
            <div class="card-body">
                <div style="position:relative;height:260px;">
                    <canvas id="status-history-chart" style="display:none;"></canvas>
                    <div id="status-history-empty" class="text-muted text-center py-4">Aucun rapport pour construire l'historique.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modale de confirmation de suppression : re-saisie du nom d'hôte obligatoire -->
<div class="modal fade" id="delete-node-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Supprimer ce nœud</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p>Cette action supprime <strong>définitivement</strong> le nœud, ses tags et son historique de rapports.</p>
                <p>Pour confirmer, tape le nom d'hôte <strong><span id="delete-required-name"></span></strong> ci-dessous :</p>
                <input type="text" class="form-control" id="delete-confirm-input" placeholder="Nom d'hôte" autocomplete="off">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="delete-node-confirm-btn" disabled>Supprimer définitivement</button>
            </div>
        </div>
    </div>
</div>

<script src="/web/node.js"></script>
{{end}}
