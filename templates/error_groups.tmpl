{{define "content"}}
<div class="container-fluid mt-4 px-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">DSC errors</h2>
        <button id="eg-refresh" class="btn btn-outline-primary btn-sm" type="button">Refresh</button>
    </div>

    <!-- Filtres -->
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="form-row align-items-start">
                <div class="form-group col-md-2 mb-2">
                    <label class="mb-1" for="eg-filter-status">Status</label>
                    <select id="eg-filter-status" class="form-control form-control-sm">
                        <option value="">All</option>
                        <option value="open">Open</option>
                        <option value="known">Known</option>
                        <option value="resolved">Resolved</option>
                    </select>
                </div>
                <div class="form-group col-md-2 mb-2">
                    <label class="mb-1" for="eg-filter-category">Category</label>
                    <input id="eg-filter-category" type="text" class="form-control form-control-sm" placeholder="e.g. Resource">
                </div>
                <div class="form-group col-md-2 mb-2">
                    <label class="mb-1" for="eg-filter-minnodes">Min. nodes</label>
                    <input id="eg-filter-minnodes" type="number" class="form-control form-control-sm" min="0" value="0">
                </div>
                <div class="form-group col-md-3 mb-2">
                    <label class="mb-1" for="eg-filter-since">Since</label>
                    <input id="eg-filter-since" type="datetime-local" class="form-control form-control-sm">
                </div>
                <div class="form-group col-md-3 mb-2 d-flex align-items-end">
                    <button id="eg-filter-apply" class="btn btn-primary btn-sm mr-1" type="button">Filter</button>
                    <button id="eg-filter-reset" class="btn btn-outline-secondary btn-sm" type="button">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-body">
            <div id="eg-count" class="text-muted mb-2"></div>
            <div class="table-responsive">
                <table id="eg-table" class="table table-bordered table-sm table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:120px;">Fingerprint</th>
                            <th style="width:110px;">Category</th>
                            <th>Message</th>
                            <th style="width:80px;">Status</th>
                            <th style="width:60px;">Nodes</th>
                            <th style="width:60px;">1h</th>
                            <th style="width:110px;">Detection</th>
                            <th style="width:140px;">First</th>
                            <th style="width:140px;">Last</th>
                        </tr>
                    </thead>
                    <tbody id="eg-tbody"></tbody>
                </table>
            </div>
            <div id="eg-pagination" class="mt-2"></div>
        </div>
    </div>
</div>

<!-- Modale de détail d'un groupe d'erreurs -->
<div class="modal fade" id="eg-detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="eg-detail-title">Error detail</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body" id="eg-detail-body"></div>
            <div class="modal-footer" id="eg-detail-footer"></div>
        </div>
    </div>
</div>

<script src="/web/error_groups.js"></script>
{{end}}
