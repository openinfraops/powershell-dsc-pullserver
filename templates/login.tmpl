<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login - DSC Pull Server</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body { background: #f4f6f9; }
        .login-box { width: 360px; margin: 7% auto; }
        .card { border-radius: 8px; }
    </style>
</head>
<body>
<div class="login-box">
    <div class="card card-primary">
        <div class="card-header text-center">
            <b>Login</b> DSC Pull Server
        </div>
        <div class="card-body">
            <div id="loginError" class="text-danger mb-2" style="display:none;"></div>
            <form id="loginForm">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" class="form-control" id="username" name="username" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" class="form-control" id="password" name="password" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Sign in</button>
                <div id="saml-login-btn"></div>
            </form>
            <script src="login_saml.js"></script>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
// Affichage du message d'erreur selon le paramètre error de l'URL
$(function() {
    function getUrlParam(name) {
        const results = new RegExp('[?&]' + name + '=([^&#]*)').exec(window.location.search);
        return results ? decodeURIComponent(results[1].replace(/\+/g, ' ')) : null;
    }
    var error = getUrlParam('error');
    if (error) {
        var msg = '';
        if (error === 'deny') {
            msg = 'Access denied: your account is not part of any group authorized to access the console. Please contact an administrator.';
        } else if (error === 'blocked') {
            msg = 'Your account is disabled. Please contact an administrator to reactivate it.';
        } else {
            msg = 'An error occurred during login. Please try again or contact an administrator.';
        }
        $('#loginError').text(msg).show();
    }
    $('#loginForm').on('submit', function(e) {
        e.preventDefault();
        $('#loginError').hide();
        $.ajax({
            url: '/api/v1/login',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                username: $('#username').val(),
                password: $('#password').val()
            }),
            success: function(resp) {
                window.location.href = '/web';
            },
            error: function(xhr) {
                $('#loginError').text('Invalid credentials').show();
            }
        });
    });
});
</script>
</body>
</html>
